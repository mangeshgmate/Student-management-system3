# Copy this file to .env and adjust as needed.

# Random long string in production, e.g: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-me

# SQLite by default; point this at Postgres/MySQL in production, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/cloudapp
DATABASE_URL=sqlite:///./cloudapp.db

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seeded automatically on first startup (replaces the old hardcoded
# admin@1234 / admin123 check that lived in the React code)
ADMIN_EMAIL=admin@1234
ADMIN_PASSWORD=admin123
